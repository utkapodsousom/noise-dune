<?xml version="1.0" encoding="utf-8"?>
<!-- No <monochrome>, and lint's objection to that is understood rather than
     overlooked: a themed icon keeps only that layer's alpha, and nothing this
     emblem reduces to was worth shipping. See docs/decisions.md. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MonochromeLauncherIcon">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
