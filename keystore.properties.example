# Copy to keystore.properties and fill in. That file is gitignored, and so is
# every *.jks and *.p12 — see .gitignore.
#
# Generate the store itself first, outside this directory (RELEASE.md has the
# full procedure and the reasons):
#
#   keytool -genkeypair -v \
#     -keystore ~/keys/noise-dune-release.jks -storetype PKCS12 \
#     -alias noise-dune -keyalg RSA -keysize 4096 -validity 36500
#
# RuStore requires RSA of at least 2048 bits. 4096 costs nothing here — the key
# is used once per release — and the long validity matters because every future
# version of the app has to carry this same signature. There is no recovery if
# the store or its password is lost: the application id becomes unusable and the
# listing has to start again from zero installs.

# Absolute path. Do not point this inside the repository.
storeFile=/home/you/keys/noise-dune-release.jks
storePassword=
keyAlias=noise-dune
keyPassword=
