<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Playback has to survive a locked screen, so it runs in a foreground
         service. There is deliberately no INTERNET permission: the app never
         talks to the network. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".NoiseDuneApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NoiseDune">

        <!-- Portrait only. The screen is one column with a circle in the middle
             and nothing to reflow; landscape halves the height, which shrinks
             the control and squeezes the voice name, and buys nothing back. The
             phone also spends the night lying on a bedside table, where a stray
             rotation is noise rather than intent.

             Lint objects twice, and both objections are understood rather than
             overlooked. LockedOrientationActivity is about Chrome OS, which is
             not what this is for. DiscouragedApi is the real one: from Android
             16 a fixed orientation is ignored on displays 600dp and wider, so
             tablets and unfolded foldables will rotate anyway. That is left
             alone deliberately — the orb and its label scale with the available
             height, so the landscape layout holds up; this lock is about phones,
             where it still applies. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.NoiseDune"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.NoiseService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>

</manifest>
